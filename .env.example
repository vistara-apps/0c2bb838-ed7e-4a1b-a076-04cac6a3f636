# StreamSpark Environment Configuration
# Copy this file to .env.local and fill in your values

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/streamspark"

# Authentication
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"
BCRYPT_ROUNDS="12"

# Base Network
BASE_RPC_URL="https://mainnet.base.org"

# Coinbase Wallet
APP_LOGO_URL="https://streamspark.app/logo.png"

# Farcaster
FARCASTER_API_KEY="your-farcaster-api-key"

# Application
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
PORT="3000"

# API Rate Limiting
RATE_LIMIT_MAX="100"

# Webhook Security
WEBHOOK_SECRET="your-webhook-secret"

# Email Configuration (optional)
EMAIL_FROM="noreply@streamspark.app"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# File Upload
MAX_FILE_SIZE="5242880"

# Cache (optional)
REDIS_URL="redis://localhost:6379"
REDIS_TTL="3600"
CACHE_TTL="300"

# Monitoring (optional)
SENTRY_DSN="your-sentry-dsn"
LOG_LEVEL="info"

# Business Configuration
PLATFORM_FEE="0.05"

# Feature Flags
FEATURE_SUBSCRIPTIONS="true"
FEATURE_MILESTONES="true"
FEATURE_NOTIFICATIONS="true"
FEATURE_ANALYTICS="true"

# Development
NODE_ENV="development"

