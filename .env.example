# StreamSpark Environment Variables

# OnchainKit API Key (required for Base integration)
NEXT_PUBLIC_ONCHAINKIT_API_KEY=your_onchainkit_api_key_here

# Base URL for the application (used for frame metadata)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Database URL (if using a database)
DATABASE_URL=your_database_url_here

# Webhook secret for frame interactions
WEBHOOK_SECRET=your_webhook_secret_here

# Optional: Analytics and monitoring
NEXT_PUBLIC_ANALYTICS_ID=your_analytics_id_here
